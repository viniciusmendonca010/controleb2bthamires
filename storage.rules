rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // documents/{partnerId}/{requestId}/{fileName}
    match /documents/{partnerId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == partnerId ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
      );
      allow write: if request.auth != null && request.auth.uid == partnerId
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }
  }
}
