rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function isOwner(partnerId) {
      return isSignedIn() && request.auth.uid == partnerId;
    }

    // one partner doc per authenticated partner, id == auth uid
    match /partners/{partnerId} {
      allow read: if isOwner(partnerId) || isAdmin();
      allow create: if isOwner(partnerId);
      allow update: if isOwner(partnerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // onboarding requests (solicitações), always tied to a partnerId field
    match /requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.partnerId == request.auth.uid;
      // partner can update their own request (e.g. upload a doc admin asked for),
      // admin can update any (status changes, feedback, doc rejection)
      allow update: if isAdmin() || (isSignedIn() && resource.data.partnerId == request.auth.uid);
    }

    // error reports
    match /errors/{errorId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.partnerId == request.auth.uid;
      allow update: if isAdmin(); // only the gestor answers
    }

    // admin allowlist — never writable from the client; add admins by hand
    // in the Firebase Console (Firestore Data tab), doc id = lowercase e-mail.
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
